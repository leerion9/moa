APP_KEY=
APP_SECRET=
ACCOUNT_NO=00000000
ACCOUNT_PRDT_CD=01
IS_PAPER_TRADING=true
SIM_MODE=true          # true=가상매매(KIS주문 미호출, 1주시뮬), false=실매매
BASE_URL_PAPER=https://openapivts.koreainvestment.com:29443
BASE_URL_LIVE=https://openapi.koreainvestment.com:9443
NAVER_HTTP_DELAY_SEC=0.05
NAVER_BATCH_SIZE=50
NAVER_BATCH_PAUSE_SEC=3.0
NAVER_REQUEST_JITTER_SEC=0.03
HEARTBEAT_SEC=600
W52_MAX_GAP_PCT=0.30   # 52주 신고가 대비 전일 종가 gap 30% 이상 낮으면 유니버스 제외
WATCHLIST_SAMPLE_SIZE=10
RESULT_WRITE_HHMM=15:32   # 장 종료(15:30) 후 result.xlsx 기록 시각
SHUTDOWN_HHMM=15:40       # 봇 종료 시각 (PC 자동 종료 전에 result 저장되도록 15:32 권장)
# VI 수집 (별도 프로세스, 장마감 후): python -m scripts.vi_collector
# 결과: data/logs/{live|paper}/vi_universe.xlsx
# Gap 갭상승 회복 전략 (장마감 후): python -m scripts.gap_collector
# 결과: data/logs/{live|paper}/gap_result.xlsx
GAP_MIN_PCT=3.0
GAP_MAX_PCT=9.0
GAP_DIP_MIN_PCT=3.0
GAP_TRAILING_STOP_PCT=0.05
GAP_BUY_QTY=1
# Gap 과거 소급 (프로그램만; 실제 크롤링은 --execute 필요)
#   python -m scripts.gap_backfill plan --year 2025
#   python -m scripts.gap_backfill run --year 2025 --limit 30          # dry-run
#   python -m scripts.gap_backfill run --year 2025 --limit 30 --execute
# 결과: data/logs/{live|paper}/gap_backfill.xlsx
GAP_BACKFILL_BATCH_SIZE=30
GAP_NAVER_TICK_DELAY_SEC=0.15
# KIS 토큰: data/kis_token_cache.json (main/vi_collector 공유, git 제외)
# 선택: 평일 공휴일 목록 파일 경로(기본 config/korea_market_holidays.txt)
# HOLIDAY_DATES_PATH=
